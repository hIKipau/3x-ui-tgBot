ENV=local
POSTGRES_DB=xui_tgbot
POSTGRES_USER=xui_bot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://xui_bot:change-me@localhost:5432/xui_tgbot?sslmode=disable

# Telegram Bot API token received from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=25s

# One shared payment confirmation code for beta testing.
BETA_PAYMENT_CODE=change-me

# 3x-ui panel root URL and a token from Settings -> Security -> API Token.
XUI_BASE_URL=https://vpn.example.com
XUI_API_TOKEN=
XUI_INBOUND_IDS=1
XUI_TIMEOUT=10s
# Use true only for a self-signed panel certificate in a trusted environment.
XUI_INSECURE_SKIP_VERIFY=false

# Defaults used when /vpn provisions a new client.
VPN_DEFAULT_QUOTA_GB=0
VPN_DEFAULT_DURATION=720h
VPN_CLIENT_FLOW=xtls-rprx-vision
VPN_PLAN_CODE=monthly
VPN_PLAN_NAME="VPN на 30 дней"
VPN_PLAN_PRICE_MINOR=29900
VPN_PLAN_CURRENCY=RUB
